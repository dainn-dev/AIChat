<?xml version="1.0" encoding="utf-8"?>
<!--
  AIChat chat reader (com.aichat.keyboard.capture.ChatCaptureService).
  Any app may be read (no packageNames filter): suggestions work wherever a conversation is on screen. Still kept narrow:
  one event type that the service ignores, no key filtering, no gestures. Window content is read only when the user taps "Gợi ý trả lời" in the keyboard.
  flagRetrieveInteractiveWindows: lets the service find the chat window behind the keyboard window.
  flagReportViewIds: lets the parser recognise the toolbar title.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/aichat__capture__service_description"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:canRequestFilterKeyEvents="false"
    android:isAccessibilityTool="false"
    android:notificationTimeout="1000"/>
