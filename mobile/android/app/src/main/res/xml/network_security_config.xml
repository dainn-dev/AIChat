<?xml version="1.0" encoding="utf-8"?>
<!--
    AIChat: network security config for release and beta builds. HTTPS only, system CAs only.
    Debug builds replace this file with app/src/debug/res/xml/network_security_config.xml.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
