<resources>
    <!-- Màn hình đồng ý đọc tin nhắn (trợ năng), workstream A -->
    <string name="aichat__capture__title">Đọc tin nhắn để gợi ý trả lời</string>
    <string name="aichat__capture__summary_on">Đang bật: đọc cuộc trò chuyện đang mở trong bất kỳ ứng dụng chat nào khi bạn bấm Gợi ý trả lời</string>
    <string name="aichat__capture__summary_off">Đang tắt: bật để Gợi ý trả lời đọc được tin nhắn</string>
    <string name="aichat__capture__intro">Để gợi ý câu trả lời hợp với cuộc trò chuyện, AIChat có thể đọc đoạn chat bạn đang trả lời. Tính năng này dùng dịch vụ trợ năng của Android. Vui lòng đọc kỹ trước khi bật.</string>
    <string name="aichat__capture__what_heading">Đọc những gì</string>
    <string name="aichat__capture__what_body">Chỉ các tin nhắn đang hiện trên màn hình trong ứng dụng bạn đang chat (Messenger, Zalo, WhatsApp, Gmail, Google Chat hay bất kỳ ứng dụng nào có cuộc trò chuyện), và tên người bạn đang chat. Kể cả các cuộc trò chuyện mã hoá đầu cuối: nội dung trên màn hình được đọc đúng như bạn thấy. Không đọc gì cho tới khi bạn bấm Gợi ý trả lời. Không bao giờ đọc ô mật khẩu hay nội dung bạn đang gõ.</string>
    <string name="aichat__capture__when_heading">Đọc khi nào</string>
    <string name="aichat__capture__when_body">Chỉ đúng lúc bạn bấm Gợi ý trả lời trên bàn phím AIChat. Không đọc ngầm, và không lưu gì trên điện thoại.</string>
    <string name="aichat__capture__where_heading">Gửi đi đâu</string>
    <string name="aichat__capture__where_body">Tin nhắn được gửi qua kết nối mã hoá tới máy chủ AIChat để viết gợi ý trả lời, kể cả tin nhắn trong cuộc trò chuyện mã hoá đầu cuối. Nếu bạn đã bật ghi nhớ trong tài khoản, máy chủ có thể lưu cuộc trò chuyện để gợi ý lần sau tốt hơn; bạn có thể xoá bất cứ lúc nào. Ở chế độ ẩn danh thì không lưu gì.</string>
    <string name="aichat__capture__off_heading">Bạn luôn kiểm soát</string>
    <string name="aichat__capture__off_body">Bạn có thể tắt bất cứ lúc nào trong phần Hỗ trợ tiếp cận (Trợ năng) của điện thoại. Khi tắt, bạn vẫn có thể copy tin nhắn rồi bấm Gợi ý trả lời.</string>
    <string name="aichat__capture__how_body">Bấm nút bên dưới, mở AIChat đọc tin nhắn trong mục Ứng dụng đã tải xuống (hoặc Dịch vụ đã cài đặt) rồi bật lên.</string>
    <string name="aichat__capture__agree_button">Đồng ý và mở cài đặt Trợ năng</string>
    <string name="aichat__capture__manage_button">Mở cài đặt Trợ năng</string>
    <string name="aichat__capture__status_on">Trạng thái: đang bật</string>
    <string name="aichat__capture__status_off">Trạng thái: đang tắt</string>
    <string name="aichat__capture__clipboard_heading">Khi không đọc được đoạn chat</string>
    <string name="aichat__capture__clipboard_body">Nếu đang tắt đọc tin nhắn, hoặc không nhận ra cuộc trò chuyện trong ứng dụng bạn đang dùng, Gợi ý trả lời sẽ dùng nội dung bạn vừa copy trong 2 phút gần nhất: nội dung đó được gửi tới máy chủ AIChat như tin nhắn của người kia. Mã xác nhận, mật khẩu và đường link chứa khoá không bao giờ được gửi.</string>
    <string name="aichat__capture__decline_button">Không, cảm ơn</string>
    <string name="aichat__capture__restricted_heading">Không bật được hoặc thấy \"Cài đặt bị hạn chế\"?</string>
    <string name="aichat__capture__restricted_body">Android chặn quyền này với ứng dụng cài từ file APK thay vì từ cửa hàng. Để cho phép:\n1. Bấm nút phía trên, chọn AIChat đọc tin nhắn và thử bật. Khi hiện \"Cài đặt bị hạn chế\", bấm OK. Android chỉ hiện tuỳ chọn ở bước 3 sau lần thử này.\n2. Quay lại đây và bấm Mở thông tin ứng dụng bên dưới.\n3. Bấm ⋮ (góc trên bên phải), chọn Cho phép cài đặt hạn chế, rồi xác nhận bằng mã PIN hoặc vân tay.\n4. Bấm lại nút phía trên và bật AIChat đọc tin nhắn.</string>
    <string name="aichat__capture__restricted_button">Mở thông tin ứng dụng</string>
    <string name="aichat__capture__service_label">AIChat đọc tin nhắn</string>
    <string name="aichat__capture__service_description">Chỉ đọc các tin nhắn đang hiện trong ứng dụng bạn đang chat khi bạn bấm Gợi ý trả lời trên bàn phím AIChat, rồi gửi tới máy chủ AIChat để viết gợi ý trả lời. Không đọc ô mật khẩu hay nội dung bạn gõ, và không chạy ngầm.</string>

