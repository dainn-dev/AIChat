    <!-- Memory opt-in -->
    <string name="aichat__memory__opt_in_title">Cho phép AIChat ghi nhớ</string>
    <string name="aichat__memory__opt_in_disclosure">Khi bật, nội dung cuộc trò chuyện mà bàn phím đọc để gợi ý, bao gồm cả tin nhắn do người khác trong cuộc trò chuyện viết, sẽ được gửi lên máy chủ AIChat, được xử lý bởi một nhà cung cấp AI bên ngoài và được lưu lại để tạo ghi nhớ (ví dụ ngày sinh hoặc sở thích của một người liên hệ) giúp gợi ý phù hợp hơn. Thông tin nhạy cảm được tự động lọc bỏ, nhưng bộ lọc không hoàn hảo. Các cuộc trò chuyện và ghi nhớ đã lưu được giữ cho đến khi bạn xoá, và bạn có thể xoá bất cứ lúc nào ở bên dưới. Tắt tuỳ chọn này sẽ xoá các cuộc trò chuyện do bàn phím ghi lại và những ghi nhớ chỉ được tạo từ chúng.</string>
    <string name="aichat__memory__opt_in_confirm_title">Bật ghi nhớ?</string>
    <string name="aichat__memory__opt_in_confirm_action">Bật</string>
    <string name="aichat__memory__opt_out_confirm_title">Tắt ghi nhớ?</string>
    <string name="aichat__memory__opt_out_confirm_message">Thao tác này sẽ xoá vĩnh viễn mọi cuộc trò chuyện do bàn phím ghi lại và những ghi nhớ chỉ được tạo từ chúng. Dữ liệu từ ảnh chụp màn hình và menu chia sẻ không bị ảnh hưởng. Bàn phím sẽ ngừng lưu các cuộc trò chuyện mới.</string>
    <string name="aichat__memory__opt_out_confirm_action">Tắt và xoá</string>
