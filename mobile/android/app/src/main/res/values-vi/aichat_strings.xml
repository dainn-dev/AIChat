    <!-- Memory opt-in -->
    <string name="aichat__memory__opt_in_title">Cho phép AIChat ghi nhớ</string>
    <string name="aichat__memory__opt_in_disclosure">Khi bật, nội dung cuộc trò chuyện mà bàn phím đọc để gợi ý, bao gồm cả tin nhắn do người khác trong cuộc trò chuyện viết, sẽ được gửi lên và lưu trên máy chủ AIChat. AIChat dùng nội dung này để tạo trí nhớ (ví dụ ngày sinh hoặc sở thích của một người liên hệ) để gợi ý phù hợp hơn. Bạn có thể xoá các cuộc trò chuyện và ghi nhớ đã lưu bất cứ lúc nào ở bên dưới. Tắt tuỳ chọn này sẽ ngừng lưu dữ liệu mới; dữ liệu đã lưu vẫn còn cho đến khi bạn xoá.</string>
    <string name="aichat__memory__opt_in_confirm_title">Bật ghi nhớ?</string>
