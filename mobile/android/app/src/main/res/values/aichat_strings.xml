    <!-- Memory opt-in -->
    <string name="aichat__memory__opt_in_title">Allow AIChat to remember</string>
    <string name="aichat__memory__opt_in_disclosure">When this is on, the chat text the keyboard reads to make suggestions, including messages written by the other people in the chat, is sent to the AIChat server, processed by an external AI provider, and stored to build memories (for example a contact\'s birthday or interests) so suggestions fit better. Sensitive information is filtered out automatically, but the filter is not perfect. Stored chats and memories are kept until you delete them, and you can delete them at any time below. Turning this off deletes the chats captured by the keyboard and the memories learned only from them.</string>
    <string name="aichat__memory__opt_in_confirm_title">Turn on memory?</string>
    <string name="aichat__memory__opt_in_confirm_action">Turn on</string>
    <string name="aichat__memory__opt_out_confirm_title">Turn off memory?</string>
    <string name="aichat__memory__opt_out_confirm_message">This permanently deletes all conversations captured by the keyboard and the memories learned only from them. Data from screenshots and the share menu is not affected. The keyboard stops storing new chats.</string>
    <string name="aichat__memory__opt_out_confirm_action">Turn off and delete</string>
