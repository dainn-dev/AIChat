<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- AIChat MODIFIED: network access for the AIChat backend client (:core:network). Cleartext is blocked by
         @xml/network_security_config except for the local dev backend in debug builds. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Permission needed to vibrate if the user has key press vibration enabled -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <!-- Permission needed to create notifications on devices running Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Android 11+ only: Define that FlorisBoard requests to see all apps that
          ship with an IME or Spell Check service. This is used to guide the user
          in the Settings Ui why FlorisBoard may not be working.
     -->
    <queries>
        <intent>
            <action android:name="android.view.InputMethod"/>
        </intent>
        <intent>
            <action android:name="android.service.textservice.SpellCheckerService"/>
        </intent>
        <!-- AIChat MODIFIED: lets the keyboard see which chat apps take a shared image, to send a sticker through
             the app's share screen when its chat field does not accept images (com.aichat.keyboard.sticker.StickerSender). -->
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="image/*"/>
        </intent>
    </queries>

    <!-- AIChat MODIFIED: Android auto-backup and device-to-device transfer disabled for v1 (the app will
         store auth tokens and chat-derived data). The in-app manual backup/restore screen is unaffected.
         AIChat MODIFIED: networkSecurityConfig disables cleartext HTTP (debug override in src/debug/res/xml). -->
    <application
        android:name="dev.patrickgold.florisboard.FlorisApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/floris_app_icon"
        android:label="@string/floris_app_name"
        android:enableOnBackInvokedCallback="true"
        android:roundIcon="@mipmap/floris_app_icon_round"
        android:supportsRtl="true"
        android:theme="@style/FlorisAppTheme"
        tools:targetApi="tiramisu">

        <!-- Allow app to be profiled for benchmarking and baseline profile generation -->
        <profileable android:shell="true"/>

        <!-- IME service -->
        <service
            android:name="dev.patrickgold.florisboard.FlorisImeService"
            android:label="@string/floris_app_name"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod"/>
            </intent-filter>
            <meta-data android:name="android.view.im" android:resource="@xml/method"/>
        </service>

        <!-- Spellchecker service -->
        <service
            android:name="dev.patrickgold.florisboard.FlorisSpellCheckerService"
            android:label="@string/floris_app_name"
            android:permission="android.permission.BIND_TEXT_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService"/>
            </intent-filter>
            <meta-data android:name="android.view.textservice.scs" android:resource="@xml/spellchecker"/>
        </service>

        <!-- AIChat MODIFIED: chat reader for reply suggestions. Reads the visible Messenger/Zalo chat only when the
             user taps "Gợi ý trả lời"; disclosed on the consent screen (com.aichat.keyboard.capture). Exported only to
             the system: BIND_ACCESSIBILITY_SERVICE is held by the system alone. -->
        <service
            android:name="com.aichat.keyboard.capture.ChatCaptureService"
            android:label="@string/aichat__capture__service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService"/>
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/aichat_accessibility_service"/>
        </service>

        <!-- Main App Activity -->
        <activity
            android:name="dev.patrickgold.florisboard.app.FlorisAppActivity"
            android:icon="@mipmap/floris_app_icon"
            android:label="@string/settings__title"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/floris_app_icon_round"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/FlorisAppTheme.Splash"
            android:exported="true">
            <!-- AIChat MODIFIED: removed the BROWSABLE ui://florisboard/... deep-link intent-filter. It let any web
                 page or app open arbitrary settings screens. Nothing in the app needs it (internal navigation uses the
                 NavController directly), and Routes.composableWithDeepLink no longer registers the deep links. -->
            <!-- AIChat MODIFIED: removed the two exported "Import Extension" intent-filters (VIEW with a content: URI
                 and SEND, for application/vnd.florisboard.extension+zip and the catch-all application/octet-stream).
                 They let any app hand this activity an arbitrary file. Extensions can still be imported from inside
                 the app (Settings > Addons > Import, which uses the system file picker). FlorisAppActivity.onNewIntent
                 also ignores such intents now, because an exported activity still receives explicit intents. -->
        </activity>

        <!-- Using an activity alias to disable/enable the app icon in the launcher -->
        <activity-alias
            android:name="dev.patrickgold.florisboard.SettingsLauncherAlias"
            android:icon="@mipmap/floris_app_icon"
            android:label="@string/floris_app_name"
            android:launchMode="singleTask"
            android:roundIcon="@mipmap/floris_app_icon_round"
            android:targetActivity="dev.patrickgold.florisboard.app.FlorisAppActivity"
            android:theme="@style/FlorisAppTheme.Splash"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>

        <!-- Crash Dialog Activity -->
        <activity
            android:name="dev.patrickgold.florisboard.lib.crashutility.CrashDialogActivity"
            android:icon="@mipmap/floris_app_icon"
            android:label="@string/crash_dialog__title"
            android:configChanges="orientation|screenSize"
            android:theme="@style/CrashDialogTheme"/>

        <!-- AIChat MODIFIED: invisible photo-picker activity that turns gallery images into stickers.
             Opened only by the keyboard itself, so it is not exported. -->
        <activity
            android:name="com.aichat.keyboard.sticker.StickerImportActivity"
            android:theme="@style/FlorisAppTheme.Transparent"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false"/>

        <!-- AIChat MODIFIED: "Tạo sticker chữ", the text sticker maker opened from the sticker panel's add menu (the
             keyboard cannot host a text field itself). Opened only by the keyboard, so it is not exported. -->
        <activity
            android:name="com.aichat.keyboard.sticker.TextStickerMakerActivity"
            android:theme="@style/FlorisAppTheme.Transparent"
            android:windowSoftInputMode="stateVisible|adjustResize"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="false"/>

        <!-- AIChat MODIFIED: share target for chat screenshots ("Gợi ý trả lời AIChat"). The image is read on-device
             (ML Kit OCR) and never uploaded; only the parsed messages go to /v1/keyboard/reply. Exported only for
             this SEND image/* filter; the activity also rejects non-content: URIs and this app's own providers. -->
        <activity
            android:name="com.aichat.keyboard.share.ShareReplyActivity"
            android:label="@string/aichat__share__target_label"
            android:icon="@mipmap/floris_app_icon"
            android:roundIcon="@mipmap/floris_app_icon_round"
            android:theme="@style/FlorisAppTheme"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>

        <!-- AIChat MODIFIED: "create sticker from photo" (com.aichat.keyboard.sticker.creator). The subject is cut out
             on-device (ML Kit subject segmentation); the photo is never uploaded. Opened from the keyboard, or from
             the share sheet ("Tạo sticker"): exported only for this SEND image/* filter, and the activity rejects
             non-content: URIs and this app's own providers. -->
        <activity
            android:name="com.aichat.keyboard.sticker.creator.StickerCreatorActivity"
            android:label="@string/aichat__sticker_creator__target_label"
            android:icon="@mipmap/floris_app_icon"
            android:roundIcon="@mipmap/floris_app_icon_round"
            android:theme="@style/FlorisAppTheme"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>

        <!-- Copy to Clipboard Activity -->
        <activity
            android:name="dev.patrickgold.florisboard.ime.clipboard.FlorisCopyToClipboardActivity"
            android:theme="@style/FlorisAppTheme.Transparent"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="image/*"/>
            </intent-filter>
        </activity>

        <!-- Clipboard Media File Provider -->
        <provider
            android:name="dev.patrickgold.florisboard.ime.clipboard.provider.ClipboardMediaProvider"
            android:authorities="${applicationId}.provider.clipboard"
            android:grantUriPermissions="true"
            android:exported="false">
        </provider>

        <!-- Default file provider to share files from the "files" or "cache" dir -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider.file"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>

        <!-- Disable default EmojiCompat initializer -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                tools:node="remove"/>
        </provider>

    </application>

</manifest>
